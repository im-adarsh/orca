+it('opens the task composer linked to the exact local repository, with a review prompt', () => {
+  mocks.state.repos = [
+    { id: 'repo', gitRemoteIdentity: { remoteUrl: 'git@github.com:acme/api.git' } }
+  ]
+  openPluginReviewWorkspace({
+    provider: 'github',
+    title: 'Fix',
+    url: 'https://github.com/acme/api/pull/7'
+  })
+  expect(mocks.openModal).toHaveBeenCalledWith(
+    'new-workspace-composer',
+    expect.objectContaining({
+      initialRepoId: 'repo',
+      linkedWorkItem: expect.objectContaining({
+        type: 'pr',
+        number: 7,
+        url: 'https://github.com/acme/api/pull/7'
+      }),
+      initialReviewPrompt: expect.stringContaining('Review the changes')
+    })
+  )
+})
+it('never selects a remote checkout or a same-name repo on a different host', () => {
+  mocks.state.repos = [
+    {
+      id: 'remote',
+      connectionId: 'ssh',
+      gitRemoteIdentity: { remoteUrl: 'git@github.com:acme/api.git' }
+    },
+    { id: 'other', gitRemoteIdentity: { remoteUrl: 'git@gitlab.com:acme/api.git' } }
+  ]
+  expect(() =>
+    openPluginReviewWorkspace({
+      provider: 'github',
+      title: 'Fix',
+      url: 'https://github.com/acme/api/pull/7'
+    })
+  ).toThrow('Add or clone')
+  expect(mocks.openModal).not.toHaveBeenCalled()
+})
+it('supports self-hosted nested GitLab projects and rejects non-review URLs', () => {
+  mocks.state.repos = [
+    { id: 'gl', gitRemoteIdentity: { remoteUrl: 'https://git.acme.test/team/sub/api.git' } }
+  ]
+  openPluginReviewWorkspace({
+    provider: 'gitlab',
+    title: 'Fix',
+    url: 'https://git.acme.test/team/sub/api/-/merge_requests/9'
+  })
+  expect(mocks.openModal.mock.calls[0]?.[1].linkedWorkItem).toMatchObject({

diff --git a/src/renderer/src/lib/plugin-review-workspace.ts b/src/renderer/src/lib/plugin-review-workspace.ts
new file mode 100644
index 000000000..3a1e98041
--- /dev/null
+++ b/src/renderer/src/lib/plugin-review-workspace.ts
@@ -0,0 +1,62 @@
+import { useAppStore } from '@/store'
+import { normalizeGitRemoteUrl } from '../../../shared/git-remote-identity'
+import { pluginReviewRequestSchema } from '../../../shared/plugins/workers/plugin-review-request'
+import { getTaskPageRepoSourceContext } from '@/components/task-page/task-page-source-context'
+
+function matchesReviewWebPort(remote: string, review: URL): boolean {
+  try {
+    const source = new URL(remote)
+    return source.protocol === 'https:' || source.protocol === 'http:'
+      ? source.port === review.port
+      : !review.port
+  } catch {
+    return !review.port
+  }
+}
+
+export function openPluginReviewWorkspace(value: unknown): void {
+  const review = pluginReviewRequestSchema.parse(value)
+  const url = new URL(review.url)
+  const separator = review.provider === 'github' ? '/pull/' : '/-/merge_requests/'
+  const [projectPath, numberText] = url.pathname.split(separator)
+  const number = Number(numberText)
+  const repositoryUrl = url.origin + projectPath
+  const key = normalizeGitRemoteUrl(repositoryUrl)
+  const state = useAppStore.getState()
+  const matches = state.repos.filter(
+    (repo) =>
+      !repo.connectionId &&
+      (!repo.executionHostId || repo.executionHostId === 'local') &&
+      normalizeGitRemoteUrl(repo.gitRemoteIdentity?.remoteUrl ?? '') === key &&
+      matchesReviewWebPort(repo.gitRemoteIdentity?.remoteUrl ?? '', url)
+  )
+  if (matches.length !== 1) {
+    throw new Error(
+      matches.length
+        ? 'Choose one local checkout for this repository in Orca before reviewing.'
+        : `Add or clone ${repositoryUrl} in Orca first, then click Review locally again.`
+    )
+  }
+  const repo = matches[0]!
+  state.openModal('new-workspace-composer', {
+    linkedWorkItem: {
+      provider: review.provider,
+      type: review.provider === 'github' ? 'pr' : 'mr',
+      number,
+      title: review.title,
+      url: review.url,
+      repoId: repo.id
+    },
+    initialRepoId: repo.id,
+    taskSourceContext: getTaskPageRepoSourceContext(
+      repo,
+      review.provider,
+      review.provider === 'gitlab'
+        ? { host: url.host, path: (projectPath ?? '').replace(/^\//, '') }
+        : undefined
+    ),
+    prefilledName: `review-${number}`,
+    initialReviewPrompt: `Review the changes in ${review.url}. Inspect the diff, report actionable bugs with file locations, and verify findings. Do not modify code unless requested.`,
+    telemetrySource: 'sidebar'
+  })
+}

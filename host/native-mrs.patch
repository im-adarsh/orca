@@ -0,0 +1,44 @@
+import { useEffect, useCallback } from 'react'
+import { useAppStore } from '@/store'
+import { usePluginNavigationStore } from '@/store/plugin-navigation'
+import { usePluginPanels, usePluginPanelsStore } from '@/store/plugin-panels'
+import PluginPanel from './right-sidebar/PluginPanel'
+import { openPluginReviewWorkspace } from '@/lib/plugin-review-workspace'
+import { openOwnedHttpLink } from '@/lib/http-link-routing'
+import { pluginHttpsUrlSchema } from '../../../shared/plugins/workers/plugin-review-request'
+
+export default function PluginNavigationPage(): React.JSX.Element | null {
+  const onActionResult = useCallback((action: string, value: unknown) => {
+    if (action === 'reviews.openLocal') {
+      openPluginReviewWorkspace(value)
+    }
+    if (
+      action === 'links.openExternal' &&
+      typeof value === 'object' &&
+      value !== null &&
+      'url' in value
+    ) {
+      openOwnedHttpLink(pluginHttpsUrlSchema.parse(value.url), {
+        forceSystemBrowser: true,
+        sourceOwner: { kind: 'local' }
+      })
+    }
+  }, [])
+  const tabKey = usePluginNavigationStore((s) => s.tabKey)
+  const previousView = usePluginNavigationStore((s) => s.previousView)
+  const panels = usePluginPanels()
+  const status = usePluginPanelsStore((s) => s.fetchStatus)
+  const available = panels.some((p) => p.tabKey === tabKey && p.placement === 'navigation')
+  useEffect(() => {
+    if ((status === 'ready' && !available) || status === 'error') {
+      useAppStore
+        .getState()
+        .setActiveView(previousView === 'plugin-page' ? 'terminal' : previousView)
+    }
+  }, [available, previousView, status])
+  return available && tabKey ? (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <PluginPanel tabKey={tabKey} onActionResult={onActionResult} />
+    </div>
+  ) : null
+}

+  })
+  expect(() =>
+    openPluginReviewWorkspace({ provider: 'gitlab', title: 'Fix', url: 'file:///tmp/private' })
+  ).toThrow()
+})
+it('does not confuse separate self-hosted instances on different HTTPS ports', () => {
+  mocks.state.repos = [
+    { id: 'default-port', gitRemoteIdentity: { remoteUrl: 'https://git.acme.test/team/api.git' } }
+  ]

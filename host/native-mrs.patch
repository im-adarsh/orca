diff --git a/src/shared/plugins/workers/plugin-bounded-json.ts b/src/shared/plugins/workers/plugin-bounded-json.ts
new file mode 100644
index 000000000..c32993335
--- /dev/null
+++ b/src/shared/plugins/workers/plugin-bounded-json.ts
@@ -0,0 +1,43 @@
+const encoder = new TextEncoder()
+export function isBoundedPluginJson(value: unknown, maxBytes = 48_000): boolean {
+  const seen = new Set<object>()
+  let bytes = 0
+  function visit(item: unknown, depth: number): boolean {
+    if (depth > 32 || bytes > maxBytes) {
+      return false
+    }
+    if (item === null || typeof item === 'boolean') {
+      bytes += 5
+      return true
+    }
+    if (typeof item === 'number') {
+      bytes += 24
+      return Number.isFinite(item)
+    }
+    if (typeof item === 'string') {
+      bytes += encoder.encode(JSON.stringify(item)).byteLength
+      return bytes <= maxBytes
+    }
+    if (typeof item !== 'object' || seen.has(item)) {
+      return false
+    }
+    if (
+      !Array.isArray(item) &&
+      Object.getPrototypeOf(item) !== Object.prototype &&
+      Object.getPrototypeOf(item) !== null
+    ) {
+      return false
+    }
+    seen.add(item)
+    bytes += 2
+    for (const [key, entry] of Object.entries(item)) {
+      bytes += encoder.encode(key).byteLength + 4
+      if (!visit(entry, depth + 1)) {
+        return false
+      }
+    }
+    seen.delete(item)
+    return bytes <= maxBytes
+  }
+  return visit(value, 0) && bytes <= maxBytes
+}

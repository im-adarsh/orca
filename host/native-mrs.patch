new file mode 100644
index 000000000..ace70dc7a
--- /dev/null
+++ b/src/main/plugins/panels/plugin-own-command.test.ts
@@ -0,0 +1,58 @@
+import { describe, it, expect } from 'vitest'
+import { PluginOwnCommandBridge } from './plugin-own-command'
+
+describe('own worker commands', () => {
+  it('binds execution to the authenticated plugin and rechecks revision', async () => {
+    let revision: string | null = 'approved'
+    const calls: unknown[] = []
+    const bridge = new PluginOwnCommandBridge({
+      revision: () => revision,
+      invoke: async (...args) => {
+        calls.push(args)
+        return { done: true }
+      }
+    })
+    expect(await bridge.invoke('alice.inbox', 'inbox', { operation: 'state' })).toEqual({
+      done: true
+    })
+    expect(calls[0]).toEqual(['alice.inbox', 'inbox', { operation: 'state' }])
+    revision = null
+    await expect(bridge.invoke('alice.inbox', 'inbox', {})).rejects.toThrow('approved')
+  })
+  it('drops results after consent revocation or content replacement', async () => {
+    let revision = 'one'
+    const bridge = new PluginOwnCommandBridge({
+      revision: () => revision,
+      invoke: async () => {
+        revision = 'two'
+        return { secret: 'old' }
+      }
+    })
+    await expect(bridge.invoke('alice.inbox', 'inbox', {})).rejects.toThrow('changed')
+  })
+  it('rejects cycles, oversized results and excessive concurrent calls', async () => {
+    const bridge = new PluginOwnCommandBridge({
+      revision: () => 'one',
+      invoke: async () => 'x'.repeat(50000)
+    })
+    await expect(bridge.invoke('alice.inbox', 'inbox', {})).rejects.toThrow('size')
+    const cycle: Record<string, unknown> = {}
+    cycle.self = cycle
+    await expect(bridge.invoke('alice.inbox', 'inbox', cycle)).rejects.toThrow('JSON')
+    let release = () => {}
+    const wait = new Promise<void>((resolve) => {
+      release = resolve
+    })
+    const busy = new PluginOwnCommandBridge({
+      revision: () => 'one',
+      invoke: async () => {
+        await wait
+        return null
+      }
+    })
+    const calls = [busy.invoke('alice.inbox', 'inbox', {}), busy.invoke('alice.inbox', 'inbox', {})]
+    await expect(busy.invoke('alice.inbox', 'inbox', {})).rejects.toThrow('concurrent')
+    release()
+    await Promise.all(calls)
+  })
+})
diff --git a/src/main/plugins/panels/plugin-own-command.ts b/src/main/plugins/panels/plugin-own-command.ts
new file mode 100644
index 000000000..43d00db17
--- /dev/null
+++ b/src/main/plugins/panels/plugin-own-command.ts
@@ -0,0 +1,43 @@
+import { isBoundedPluginJson } from '../../../shared/plugins/workers/plugin-bounded-json'
+
+export class PluginOwnCommandBridge {
+  private readonly active = new Map<string, number>()
+  constructor(
+    private readonly options: {
+      revision: (pluginKey: string) => string | null
+      invoke: (pluginKey: string, commandId: string, args: unknown) => Promise<unknown>
+    }
+  ) {}
+
+  async invoke(pluginKey: string, commandId: string, args: unknown): Promise<unknown> {
+    const revision = this.options.revision(pluginKey)
+    if (!revision) {
+      throw new Error('plugin is not approved')
+    }
+    if (!isBoundedPluginJson(args ?? null, 12_000)) {
+      throw new Error('command arguments exceed the JSON size or depth limit')
+    }
+    const count = this.active.get(pluginKey) ?? 0
+    if (count >= 2) {
+      throw new Error('too many concurrent plugin commands')
+    }
+    this.active.set(pluginKey, count + 1)
+    try {
+      const result = await this.options.invoke(pluginKey, commandId, args)
+      if (this.options.revision(pluginKey) !== revision) {
+        throw new Error('plugin approval changed while the command ran')
+      }
+      if (!isBoundedPluginJson(result)) {
+        throw new Error('command result exceeds the JSON size or depth limit')
+      }
+      return result
+    } finally {
+      const remaining = (this.active.get(pluginKey) ?? 1) - 1
+      if (remaining) {
+        this.active.set(pluginKey, remaining)
+      } else {
+        this.active.delete(pluginKey)
+      }
+    }
+  }
+}

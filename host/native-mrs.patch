diff --git a/src/shared/plugins/workers/plugin-review-request.ts b/src/shared/plugins/workers/plugin-review-request.ts
new file mode 100644
index 000000000..0004180a3
--- /dev/null
+++ b/src/shared/plugins/workers/plugin-review-request.ts
@@ -0,0 +1,34 @@
+import { z } from 'zod'
+
+export const pluginHttpsUrlSchema = z
+  .string()
+  .max(2048)
+  .refine((value) => {
+    try {
+      const url = new URL(value)
+      return url.protocol === 'https:' && !url.username && !url.password && !url.search && !url.hash
+    } catch {
+      return false
+    }
+  }, 'use an HTTPS URL without credentials, query or fragment')
+
+export const pluginReviewRequestSchema = z
+  .strictObject({
+    provider: z.enum(['github', 'gitlab']),
+    url: pluginHttpsUrlSchema,
+    title: z
+      .string()
+      .min(1)
+      .max(512)
+      .refine((value) =>
+        Array.from(value).every((char) => char.charCodeAt(0) >= 32 && char.charCodeAt(0) !== 127)
+      )
+  })
+  .refine((value) => {
+    const path = new URL(value.url).pathname
+    return value.provider === 'github'
+      ? /^\/[\w.-]+\/[\w.-]+\/pull\/[1-9]\d*$/.test(path)
+      : /^\/(?:[\w.-]+\/)+-\/merge_requests\/[1-9]\d*$/.test(path)
+  }, 'use a pull request or merge request URL')
+
+export type PluginReviewRequest = z.infer<typeof pluginReviewRequestSchema>

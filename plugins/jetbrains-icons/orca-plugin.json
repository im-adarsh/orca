{
  "manifestVersion": 2,
  "id": "jetbrains-icons",
  "publisher": "im-adarsh",
  "name": "im Studio File Icons",
  "version": "1.1.0",
  "execution": "data",
  "description": "Pinned Apache-licensed JetBrains New UI and Classic file icons, with light/dark choices and clearly identified original fallbacks.",
  "license": "Apache-2.0",
  "repository": "https://github.com/im-adarsh/orca",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "new-ui-dark",
        "title": "im-new-ui-dark",
        "path": "themes/new-ui-dark.json"
      },
      {
        "id": "new-ui-light",
        "title": "im-new-ui-light",
        "path": "themes/new-ui-light.json"
      },
      {
        "id": "classic-dark",
        "title": "im-classic-dark",
        "path": "themes/classic-dark.json"
      },
      {
        "id": "classic-light",
        "title": "im-classic-light",
        "path": "themes/classic-light.json"
      }
    ]
  },
  "capabilities": []
}

{
  "schemaVersion": 1,
  "name": "im Theme Collection",
  "format": "Reference checklist; this is not an Orca settings import file.",
  "appearance": {
    "ideFont": "Inter Variable (or Inter, depending on the installed font name)",
    "leftSidebarAppearance": "Default",
    "windowBlur": false
  },
  "editor": {
    "fontFamily": "JetBrains Mono",
    "minimap": false,
    "wordWrap": true
  },
  "terminal": {
    "fontFamily": "JetBrains Mono",
    "fontSize": 14,
    "fontWeight": 400,
    "boldFontWeight": 700,
    "lineHeight": 1.2,
    "backgroundOpacity": 1,
    "activePaneOpacity": 1,
    "inactivePaneOpacity": 1,
    "windowBlur": false,
    "cursorStyle": "bar",
    "cursorBlink": true,
    "cursorOpacity": 1,
    "ligatures": "auto",
    "separateLightTheme": true,
    "colorOverrides": "Clear overrides for both dark and light modes"
  },
  "chat": {
    "matchTerminalInterface": true,
    "width": "wide",
    "contrast": 100
  },
  "themePairs": [
    {
      "app": "im-islands-dark",
      "terminal": "im-islands-dark",
      "mode": "dark"
    },
    {
      "app": "im-islands-light",
      "terminal": "im-islands-light",
      "mode": "light"
    },
    {
      "app": "im-studio-dark",
      "terminal": "im-studio-dark",
      "mode": "dark"
    },
    {
      "app": "im-studio-light",
      "terminal": "im-studio-light",
      "mode": "light"
    },
    {
      "app": "im-classic-dark",
      "terminal": "im-classic-dark",
      "mode": "dark"
    },
    {
      "app": "im-classic-light",
      "terminal": "im-classic-light",
      "mode": "light"
    },
    {
      "app": "im-high-contrast",
      "terminal": "im-high-contrast",
      "mode": "dark"
    },
    {
      "app": "im-matte",
      "terminal": "im-matte",
      "mode": "light"
    },
    {
      "app": "im-graphite",
      "terminal": "im-graphite",
      "mode": "dark"
    },
    {
      "app": "im-paper",
      "terminal": "im-paper",
      "mode": "light"
    },
    {
      "app": "im-slate",
      "terminal": "im-slate",
      "mode": "dark"
    },
    {
      "app": "im-ember",
      "terminal": "im-ember",
      "mode": "dark"
    },
    {
      "app": "im-daylight",
      "terminal": "im-daylight",
      "mode": "light"
    }
  ],
  "shortcuts": {
    "CmdOrCtrl+Alt+1": "Project Window",
    "CmdOrCtrl+Alt+9": "Version Control",
    "CmdOrCtrl+Alt+Shift+F": "Find in Project"
  }
}

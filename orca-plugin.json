{
  "manifestVersion": 1,
  "id": "jetbrains-themes",
  "publisher": "im-adarsh",
  "name": "im Theme Collection",
  "version": "1.6.0",
  "description": "Thirteen layered im palettes with distinctive selection accents, matched terminals and a portable setup guide.",
  "repository": "https://github.com/im-adarsh/orca",
  "engines": {
    "orca": ">=1.4.244"
  },
  "pluginApi": 1,
  "contributes": {
    "themes": [
      {
        "id": "islands-dark",
        "label": "im-islands-dark",
        "path": "themes/islands-dark.json"
      },
      {
        "id": "islands-light",
        "label": "im-islands-light",
        "path": "themes/islands-light.json"
      },
      {
        "id": "jetbrains-dark",
        "label": "im-studio-dark",
        "path": "themes/jetbrains-dark.json"
      },
      {
        "id": "jetbrains-light",
        "label": "im-studio-light",
        "path": "themes/jetbrains-light.json"
      },
      {
        "id": "classic-dark",
        "label": "im-classic-dark",
        "path": "themes/classic-dark.json"
      },
      {
        "id": "classic-light",
        "label": "im-classic-light",
        "path": "themes/classic-light.json"
      },
      {
        "id": "high-contrast",
        "label": "im-high-contrast",
        "path": "themes/high-contrast.json"
      },
      {
        "id": "matte",
        "label": "im-matte",
        "path": "themes/matte.json"
      },
      {
        "id": "graphite",
        "label": "im-graphite",
        "path": "themes/graphite.json"
      },
      {
        "id": "paper",
        "label": "im-paper",
        "path": "themes/paper.json"
      },
      {
        "id": "slate",
        "label": "im-slate",
        "path": "themes/slate.json"
      },
      {
        "id": "im-ember",
        "label": "im-ember",
        "path": "themes/im-ember.json"
      },
      {
        "id": "im-daylight",
        "label": "im-daylight",
        "path": "themes/im-daylight.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "islands-dark-terminal",
        "label": "im-islands-dark",
        "path": "themes/islands-dark-terminal.json"
      },
      {
        "id": "islands-light-terminal",
        "label": "im-islands-light",
        "path": "themes/islands-light-terminal.json"
      },
      {
        "id": "jetbrains-dark-terminal",
        "label": "im-studio-dark",
        "path": "themes/jetbrains-dark-terminal.json"
      },
      {
        "id": "jetbrains-light-terminal",
        "label": "im-studio-light",
        "path": "themes/jetbrains-light-terminal.json"
      },
      {
        "id": "classic-dark-terminal",
        "label": "im-classic-dark",
        "path": "themes/classic-dark-terminal.json"
      },
      {
        "id": "classic-light-terminal",
        "label": "im-classic-light",
        "path": "themes/classic-light-terminal.json"
      },
      {
        "id": "high-contrast-terminal",
        "label": "im-high-contrast",
        "path": "themes/high-contrast-terminal.json"
      },
      {
        "id": "matte-terminal",
        "label": "im-matte",
        "path": "themes/matte-terminal.json"
      },
      {
        "id": "graphite-terminal",
        "label": "im-graphite",
        "path": "themes/graphite-terminal.json"
      },
      {
        "id": "paper-terminal",
        "label": "im-paper",
        "path": "themes/paper-terminal.json"
      },
      {
        "id": "slate-terminal",
        "label": "im-slate",
        "path": "themes/slate-terminal.json"
      },
      {
        "id": "im-ember-terminal",
        "label": "im-ember",
        "path": "themes/im-ember-terminal.json"
      },
      {
        "id": "im-daylight-terminal",
        "label": "im-daylight",
        "path": "themes/im-daylight-terminal.json"
      }
    ],
    "panels": [
      {
        "id": "goland-setup",
        "title": "im Theme Setup",
        "icon": "Palette",
        "entry": "setup/index.html"
      }
    ],
    "commands": [
      {
        "id": "project-window",
        "title": "im Workspace: Project Window",
        "context": "global",
        "action": "sidebar.explorer.toggle"
      },
      {
        "id": "version-control",
        "title": "im Workspace: Version Control",
        "context": "global",
        "action": "sidebar.sourceControl.toggle"
      },
      {
        "id": "find-in-project",
        "title": "im Workspace: Find in Project",
        "context": "global",
        "action": "sidebar.search.toggle"
      }
    ],
    "keybindings": [
      {
        "command": "project-window",
        "key": "Mod+Alt+1",
        "when": "global"
      },
      {
        "command": "version-control",
        "key": "Mod+Alt+9",
        "when": "global"
      },
      {
        "command": "find-in-project",
        "key": "Mod+Alt+Shift+F",
        "when": "global"
      }
    ]
  },
  "capabilities": [],
  "execution": "sandboxed-ui"
}
